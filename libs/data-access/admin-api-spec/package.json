{
  "name": "@restate/data-access-admin-api-spec",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {},
  "nx": {
    "targets": {
      "create": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "./libs/data-access/admin-api-spec/src/merge.mjs",
            "redocly lint ./libs/data-access/admin-api-spec/src/lib/output.json || true",
            "openapi-typescript ./libs/data-access/admin-api-spec/src/lib/output.json -o ./libs/data-access/admin-api-spec/src/lib/index.d.ts",
            "nx format"
          ],
          "parallel": false
        }
      }
    }
  }
}
