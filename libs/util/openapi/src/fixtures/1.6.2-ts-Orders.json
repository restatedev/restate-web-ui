{
  "components": {
    "parameters": {
      "delay": {
        "description": "Specify the delay to execute the operation, for more info check the [delay documentation](https://docs.restate.dev/invoke/http#sending-a-delayed-message-over-http)",
        "example": "10s",
        "in": "query",
        "name": "delay",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "idempotencyKeyHeader": {
        "description": "Idempotency key to execute the request, for more details checkout the [idempotency key documentation](https://docs.restate.dev/invoke/http#invoke-a-handler-idempotently).",
        "in": "header",
        "name": "idempotency-key",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "idempotencyKeyPath": {
        "description": "Idempotency key used to execute the original request, for more details checkout the [idempotency key documentation](https://docs.restate.dev/invoke/http#invoke-a-handler-idempotently).",
        "in": "path",
        "name": "idempotencyKey",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "key": {
        "in": "path",
        "name": "key",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "GenericError": {
        "content": {
          "application/json": {
            "example": {
              "code": 500,
              "description": "Very bad error happened",
              "message": "Internal server error"
            },
            "schema": {
              "$ref": "#/components/schemas/RestateError"
            }
          }
        },
        "description": "Error response"
      },
      "InvocationNotFoundError": {
        "content": {
          "application/json": {
            "example": {
              "code": 404,
              "message": "Not found"
            },
            "schema": {
              "$ref": "#/components/schemas/RestateError"
            }
          }
        },
        "description": "Invocation not found"
      },
      "InvocationNotReadyError": {
        "content": {
          "application/json": {
            "example": {
              "code": 470,
              "message": "Not ready"
            },
            "schema": {
              "$ref": "#/components/schemas/RestateError"
            }
          }
        },
        "description": "Invocation still running, output is not ready yet"
      },
      "Send": {
        "content": {
          "application/json": {
            "example": {
              "invocationId": "inv_1gdJBtdVEcM942bjcDmb1c1khoaJe11Hbz",
              "status": "Accepted"
            },
            "schema": {
              "additionalProperties": false,
              "properties": {
                "executionTime": {
                  "description": "Time when the invocation will be executed, in case 'delay' is used",
                  "format": "date-time",
                  "type": "string"
                },
                "invocationId": {
                  "type": "string"
                },
                "status": {
                  "enum": ["Accepted", "PreviouslyAccepted"],
                  "type": "string"
                }
              },
              "required": ["invocationId", "status"],
              "title": "RestateSendResponse",
              "type": "object"
            }
          }
        },
        "description": "Send response"
      }
    },
    "schemas": {
      "RestateError": {
        "additionalProperties": false,
        "description": "Generic error used by Restate to propagate Terminal errors/exceptions back to callers",
        "properties": {
          "code": {
            "title": "error code",
            "type": "number"
          },
          "message": {
            "title": "Error message",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Additional metadata map",
            "type": "object"
          },
          "stacktrace": {
            "title": "Stacktrace of the error",
            "type": "string"
          }
        },
        "required": ["message"],
        "title": "RestateError",
        "type": "object"
      },
      "classifyRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "content": {
                "type": "string"
              },
              "type": {
                "const": "text",
                "type": "string"
              }
            },
            "required": ["type", "content"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "height": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              "type": {
                "const": "image",
                "type": "string"
              },
              "url": {
                "format": "uri",
                "type": "string"
              },
              "width": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              }
            },
            "required": ["type", "url", "width", "height"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "empty",
                "type": "string"
              }
            },
            "required": ["type"],
            "type": "object"
          }
        ]
      },
      "classifyResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": ["string", "number", "boolean"]
      },
      "createRequest": {
        "$defs": {
          "Address": {
            "additionalProperties": false,
            "description": "Postal address",
            "properties": {
              "city": {
                "description": "City name",
                "type": "string"
              },
              "country": {
                "description": "ISO 3166-1 alpha-2 country code",
                "maxLength": 2,
                "minLength": 2,
                "type": "string"
              },
              "postalCode": {
                "pattern": "^[0-9]{5}$",
                "type": "string"
              },
              "street": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": ["street", "city", "postalCode", "country"],
            "title": "Address",
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Request to create an order",
        "properties": {
          "billingAddress": {
            "$ref": "#/components/schemas/createRequest/$defs/Address"
          },
          "counters": {
            "additionalProperties": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "description": "Arbitrary named counters",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "customerEmail": {
            "examples": ["jane@example.com"],
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "type": "string"
          },
          "discount": {
            "default": 0,
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "extra": {},
          "giftMessage": {
            "type": ["string", "null"]
          },
          "items": {
            "description": "At least one line item",
            "items": {
              "additionalProperties": false,
              "properties": {
                "quantity": {
                  "maximum": 100,
                  "minimum": 1,
                  "type": "integer"
                },
                "sku": {
                  "description": "Stock keeping unit",
                  "type": "string"
                },
                "unitPrice": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                }
              },
              "required": ["sku", "quantity", "unitPrice"],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "kind": {
            "const": "order",
            "type": "string"
          },
          "notes": {
            "description": "Free text notes",
            "maxLength": 500,
            "type": "string"
          },
          "orderId": {
            "description": "Client-generated order id",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          },
          "placedAt": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "type": "string"
          },
          "priority": {
            "maximum": 10,
            "minimum": 0,
            "type": "integer"
          },
          "shippingAddress": {
            "$ref": "#/components/schemas/createRequest/$defs/Address"
          },
          "status": {
            "default": "draft",
            "enum": ["draft", "submitted", "paid"],
            "type": "string"
          }
        },
        "required": [
          "orderId",
          "customerEmail",
          "placedAt",
          "kind",
          "status",
          "giftMessage",
          "shippingAddress",
          "items",
          "counters",
          "discount"
        ],
        "type": "object"
      },
      "createResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "type": "string"
          },
          "currency": {
            "enum": ["EUR", "USD"],
            "type": "string"
          },
          "estimatedDelivery": {
            "anyOf": [
              {
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "orderId": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "orderId",
          "total",
          "currency",
          "estimatedDelivery",
          "createdAt"
        ],
        "type": "object"
      },
      "echoRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string"
      },
      "echoResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string"
      },
      "forestRequest": {
        "$defs": {
          "__schema0": {
            "additionalProperties": false,
            "properties": {
              "children": {
                "items": {
                  "$ref": "#/components/schemas/forestRequest/$defs/__schema0"
                },
                "type": "array"
              },
              "value": {
                "type": "string"
              }
            },
            "required": ["value", "children"],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "trees": {
            "items": {
              "$ref": "#/components/schemas/forestRequest/$defs/__schema0"
            },
            "type": "array"
          }
        },
        "required": ["label", "trees"],
        "type": "object"
      },
      "forestResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
      },
      "treeRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "children": {
            "items": {
              "$ref": "#/components/schemas/treeRequest"
            },
            "type": "array"
          },
          "value": {
            "type": "string"
          }
        },
        "required": ["value", "children"],
        "type": "object"
      },
      "treeResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
      },
      "uploadResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "size": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          }
        },
        "required": ["size"],
        "type": "object"
      }
    }
  },
