{
  "components": {
    "parameters": {
      "delay": {
        "description": "Specify the delay to execute the operation, for more info check the [delay documentation](https://docs.restate.dev/invoke/http#sending-a-delayed-message-over-http)",
        "example": "10s",
        "in": "query",
        "name": "delay",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "idempotencyKeyHeader": {
        "description": "Idempotency key to execute the request, for more details checkout the [idempotency key documentation](https://docs.restate.dev/invoke/http#invoke-a-handler-idempotently).",
        "in": "header",
        "name": "idempotency-key",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "idempotencyKeyPath": {
        "description": "Idempotency key used to execute the original request, for more details checkout the [idempotency key documentation](https://docs.restate.dev/invoke/http#invoke-a-handler-idempotently).",
        "in": "path",
        "name": "idempotencyKey",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "key": {
        "in": "path",
        "name": "key",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "GenericError": {
        "content": {
          "application/json": {
            "example": {
              "code": 500,
              "description": "Very bad error happened",
              "message": "Internal server error"
            },
            "schema": {
              "$ref": "#/components/schemas/RestateError"
            }
          }
        },
        "description": "Error response"
      },
      "InvocationNotFoundError": {
        "content": {
          "application/json": {
            "example": {
              "code": 404,
              "message": "Not found"
            },
            "schema": {
              "$ref": "#/components/schemas/RestateError"
            }
          }
        },
        "description": "Invocation not found"
      },
      "InvocationNotReadyError": {
        "content": {
          "application/json": {
            "example": {
              "code": 470,
              "message": "Not ready"
            },
            "schema": {
              "$ref": "#/components/schemas/RestateError"
            }
          }
        },
        "description": "Invocation still running, output is not ready yet"
      },
      "Send": {
        "content": {
          "application/json": {
            "example": {
              "invocationId": "inv_1gdJBtdVEcM942bjcDmb1c1khoaJe11Hbz",
              "status": "Accepted"
            },
            "schema": {
              "additionalProperties": false,
              "properties": {
                "executionTime": {
                  "description": "Time when the invocation will be executed, in case 'delay' is used",
                  "format": "date-time",
                  "type": "string"
                },
                "invocationId": {
                  "type": "string"
                },
                "status": {
                  "enum": ["Accepted", "PreviouslyAccepted"],
                  "type": "string"
                }
              },
              "required": ["invocationId", "status"],
              "title": "RestateSendResponse",
              "type": "object"
            }
          }
        },
        "description": "Send response"
      }
    },
    "schemas": {
      "RestateError": {
        "additionalProperties": false,
        "description": "Generic error used by Restate to propagate Terminal errors/exceptions back to callers",
        "properties": {
          "code": {
            "title": "error code",
            "type": "number"
          },
          "message": {
            "title": "Error message",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Additional metadata map",
            "type": "object"
          },
          "stacktrace": {
            "title": "Stacktrace of the error",
            "type": "string"
          }
        },
        "required": ["message"],
        "title": "RestateError",
        "type": "object"
      },
      "addRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "note": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "quantity": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          }
        },
        "required": ["productId", "quantity"],
        "type": "object"
      },
      "addResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
      },
      "itemsResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "items": {
          "additionalProperties": false,
          "properties": {
            "note": {
              "type": "string"
            },
            "productId": {
              "type": "string"
            },
            "quantity": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": ["productId", "quantity"],
          "type": "object"
        },
        "type": "array"
      }
    }
  },
  "info": {
    "description": "A shopping cart keyed by user id.",
    "title": "Cart",
    "version": "1"
  },
  "openapi": "3.1.0",
