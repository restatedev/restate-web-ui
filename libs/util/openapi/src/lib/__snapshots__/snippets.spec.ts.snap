exports[`typescript SDK client > writes a virtual object send with a delay and an idempotency key 1`] = `
"import * as clients from '@restatedev/restate-sdk-clients';

const rs = clients.connect({
  url: 'http://localhost:8080',
  headers: { Authorization: 'Bearer <API_KEY>' },
});
const handle = await rs.send<unknown>({
  service: 'Cart',
  handler: 'add',
  key: 'user/42',
  parameter: {
    sku: "a",
    note: "$5 \\\\ off",
    qty: 2,
    gift: null
  },
  opts: clients.rpc.sendOpts({ idempotencyKey: 'abc', delay: 10000 }),
});
console.log(handle.invocationId);"
`;
