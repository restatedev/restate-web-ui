exports[`go SDK client > calls a workflow and a scoped service without input 1`] = `
"// go get github.com/restatedev/sdk-go
package main

import (
	"context"
	"encoding/json"
	"fmt"

	"github.com/restatedev/sdk-go/ingress"
)

func main() {
	client := ingress.NewClient("http://localhost:8080")
	input := json.RawMessage(\`{
	  "email": "jane@example.com"
	}\`)
	output, err := ingress.Workflow[json.RawMessage, json.RawMessage](client, "Signup", "jane", "run").
		Request(context.Background(), input)
	if err != nil {
		panic(err)
	}
	fmt.Println(string(output))
}"
`;

exports[`go SDK client > calls a workflow and a scoped service without input 2`] = `
"// go get github.com/restatedev/sdk-go
package main

import (
	"context"
	"encoding/json"
	"fmt"

	restate "github.com/restatedev/sdk-go"
	"github.com/restatedev/sdk-go/ingress"
)

func main() {
	client := ingress.NewClient("http://localhost:8080")
	input := restate.Void{}
	output, err := ingress.Service[restate.Void, json.RawMessage](client, "acme.Orders", "ping", restate.WithScope("tenant-1")).
		Request(context.Background(), input, restate.WithLimitKey("team-a/user-1"))
	if err != nil {
		panic(err)
	}
	fmt.Println(string(output))
}"
`;

exports[`go SDK client > writes a virtual object send with a delay and an idempotency key 1`] = `
"// go get github.com/restatedev/sdk-go
package main

import (
	"context"
	"encoding/json"
	"fmt"
	"time"

	restate "github.com/restatedev/sdk-go"
	"github.com/restatedev/sdk-go/ingress"
)

func main() {
	client := ingress.NewClient("http://localhost:8080", ingress.WithAuthKey("<API_KEY>"))
	input := json.RawMessage(\`{
	  "sku": "a",
	  "note": "$5 \\\\ off",
	  "qty": 2,
	  "gift": null
	}\`)
	handle, err := ingress.ObjectSend[json.RawMessage](client, "Cart", "user/42", "add").
		Send(context.Background(), input, restate.WithIdempotencyKey("abc"), restate.WithDelay(10*time.Second))
	if err != nil {
		panic(err)
	}
	fmt.Println(handle.Id())
}"
`;

exports[`java SDK client > calls a workflow and a scoped service without input 1`] = `
"// implementation("dev.restate:client:2.11.0")
import dev.restate.client.Client;
import dev.restate.common.Request;
import dev.restate.common.Target;
import dev.restate.serde.Serde;
import java.nio.charset.StandardCharsets;

public class Main {
    public static void main(String[] args) {
        var client = Client.connect("http://localhost:8080");
        var json = Serde.withContentType("application/json", Serde.RAW);
        var body = """
            {
              "email": "jane@example.com"
            }
            """.getBytes(StandardCharsets.UTF_8);
        var result = client.call(
            Request.of(Target.workflow("Signup", "jane", "run"), json, json, body)).response();
        System.out.println(new String(result, StandardCharsets.UTF_8));
    }
}"
`;

