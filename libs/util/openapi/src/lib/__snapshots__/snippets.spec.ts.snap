exports[`java SDK client > writes a virtual object send with a delay and an idempotency key 1`] = `
"// implementation("dev.restate:client:2.11.0")
import dev.restate.client.Client;
import dev.restate.client.RequestOptions;
import dev.restate.common.Request;
import dev.restate.common.Target;
import dev.restate.serde.Serde;
import java.nio.charset.StandardCharsets;
import java.time.Duration;

public class Main {
    public static void main(String[] args) {
        var client = Client.connect(
            "http://localhost:8080",
            RequestOptions.builder().header("Authorization", "Bearer <API_KEY>").build());
        var json = Serde.withContentType("application/json", Serde.RAW);
        var body = """
            {
              "sku": "a",
              "note": "$5 \\\\\\\\ off",
              "qty": 2,
              "gift": null
            }
            """.getBytes(StandardCharsets.UTF_8);
        var handle = client.send(
            Request.of(Target.virtualObject("Cart", "user/42", "add"), json, json, body)
                .idempotencyKey("abc"),
            Duration.ofMillis(10000));
        System.out.println(handle.invocationId());
    }
}"
`;

exports[`python SDK client > calls a workflow and a scoped service without input 1`] = `
"# pip install "restate-sdk[client]"
import asyncio
import json

import restate


async def main():
    body = json.dumps({
        "email": "jane@example.com",
    }).encode()
    async with restate.create_client("http://localhost:8080") as client:
        result = await client.generic_call(
            "Signup",
            "run",
            body,
            key="jane",
            headers={"Content-Type": "application/json"},
        )
        print(json.loads(result) if result else None)


asyncio.run(main())"
`;

exports[`python SDK client > calls a workflow and a scoped service without input 2`] = `
"# pip install "restate-sdk[client]"
import asyncio
import json

import restate


async def main():
    body = b""
    async with restate.create_client("http://localhost:8080") as client:
        result = await client.generic_call(
            "acme.Orders",
            "ping",
            body,
            scope="tenant-1",
            limit_key="team-a/user-1",
            headers={"Content-Type": "application/json"},
        )
        print(json.loads(result) if result else None)


asyncio.run(main())"
`;

exports[`python SDK client > writes a virtual object send with a delay and an idempotency key 1`] = `
"# pip install "restate-sdk[client]"
import asyncio
import json
from datetime import timedelta

import restate


async def main():
    body = json.dumps({
        "sku": "a",
        "note": "$5 \\\\ off",
        "qty": 2,
        "gift": None,
    }).encode()
    async with restate.create_client(
        "http://localhost:8080",
        headers={"Authorization": "Bearer <API_KEY>"},
    ) as client:
        handle = await client.generic_send(
            "Cart",
            "add",
            body,
            key="user/42",
            idempotency_key="abc",
            send_delay=timedelta(milliseconds=10000),
            headers={"Content-Type": "application/json"},
        )
        print(handle.invocation_id)


asyncio.run(main())"
`;

