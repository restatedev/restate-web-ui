{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "../../../@types/global-env.d.ts"
    ]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../deployment/tsconfig.lib.json"
    },
    {
      "path": "../../util/errors/tsconfig.lib.json"
    },
    {
      "path": "../../data-access/admin-api-spec/tsconfig.lib.json"
    },
    {
      "path": "../../data-access/admin-api/tsconfig.lib.json"
    },
    {
      "path": "../../data-access/admin-api-hooks/tsconfig.lib.json"
    }
  ]
}
