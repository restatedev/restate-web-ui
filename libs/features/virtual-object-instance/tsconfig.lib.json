{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "../../../@types/global-env.d.ts"
    ]
  },
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.spec.tsx",
    "**/*.test.tsx",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../../util/styles/tsconfig.lib.json"
    },
    {
      "path": "../../ui/tooltip/tsconfig.lib.json"
    },
    {
      "path": "../../ui/link/tsconfig.lib.json"
    },
    {
      "path": "../../ui/icons/tsconfig.lib.json"
    },
    {
      "path": "../../ui/chip/tsconfig.lib.json"
    },
    {
      "path": "../vqueue-ui/tsconfig.lib.json"
    }
  ]
}
