{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "isolatedModules": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "dom"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "tmp"]
}
